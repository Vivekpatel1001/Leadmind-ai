# LeadMind AI - Environment Configuration Template
# Copy this file to .env and fill in your API credentials.

# External Live Data APIs
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
APOLLO_API_KEY=your_apollo_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Database URL (Default SQLite with AsyncEngine)
DATABASE_URL=sqlite+aiosqlite:///./leadgen.db

# Observability & Tracing (LangSmith - Optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=Lead Generation B2B

# AI LLM Keys (Gemini 1.5 Flash recommended)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
GROQ_API_KEY=

# Twilio Telephony (Live Cellular Voice Calling - Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
